# Formularz kontaktowy (app/api/contact/route.ts) — wysyłka przez SMTP OVH (Zimbra).
# Skopiuj do .env.local i uzupełnij lokalnie. Na produkcji te same nazwy
# ustaw w Vercel → Settings → Environment Variables (hasło jako "Sensitive").
# NIE commituj prawdziwych wartości.

SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=465
# Opcjonalnie: true/false. Domyślnie true dla portu 465.
# SMTP_SECURE=true

# Login = pełny adres skrzynki, z której wysyłamy
SMTP_USER=kontakt@inner-logos.pl
SMTP_PASS=

# Odbiorca wiadomości z formularza (domyślnie SMTP_USER)
CONTACT_TO=kontakt@inner-logos.pl
